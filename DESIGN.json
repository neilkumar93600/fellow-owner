      "css": ".ds-nav{position:relative;display:inline-grid;place-items:center;height:44px;padding:0 16px;border-radius:999px;background:rgba(255,255,255,.85);color:#1E1B26;font:500 15px/1 Inter,system-ui,sans-serif;text-decoration:none}.ds-nav::after{content:\"\";position:absolute;bottom:6px;left:50%;width:3px;height:3px;border-radius:50%;background:#F0603A;transform:translateX(-50%)}"
    }
