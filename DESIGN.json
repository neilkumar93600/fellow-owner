      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one Lake Blue action per screen: full pill, 48px, mono 14px uppercase, white words, no shadow, lake-hover on hover, 0.98 press, 2px ink focus ring.",
      "html": "<button class=\"ds-primary\" type=\"button\">Send Mira an idea</button>",
      "css": ".ds-primary{height:48px;padding:0 32px;border:0;border-radius:100px;background:#2B59D1;color:#fff;font:500 14px/1 'Geist Mono',ui-monospace,monospace;letter-spacing:-.02em;text-transform:uppercase}.ds-primary:hover{background:#234AAE}.ds-primary:focus-visible{outline:2px solid #242424;outline-offset:2px}.ds-primary:active{transform:scale(.98)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A frosted glass pill with an Ash hairline and ink words: every action that is not the screen's one Lake Blue.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Reply in my voice</button>",
      "css": ".ds-secondary{height:48px;padding:0 20px;border:1px solid rgb(206 202 200/.75);border-radius:100px;background:rgb(255 255 255/.72);color:#242424;font:500 14px/1 'Geist Mono',ui-monospace,monospace;letter-spacing:-.02em;text-transform:uppercase;-webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);box-shadow:inset 1px 1px 0 rgb(255 255 255/.7)}.ds-secondary:hover{background:rgb(255 255 255/.9)}"
    },
