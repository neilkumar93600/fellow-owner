  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one coral action per screen: 48px pill, white Label, coral-hover on hover, 0.98 press, 2px ink focus ring.",
      "html": "<button class=\"ds-primary\" type=\"button\">Send Mira an idea</button>",
      "css": ".ds-primary{height:48px;padding:0 24px;border:0;border-radius:999px;background:#C8432A;color:#fff;font:500 15px/1 Inter,system-ui,sans-serif;box-shadow:0 10px 24px -12px rgb(200 67 42/.6)}.ds-primary:hover{background:#A9361F}.ds-primary:focus-visible{outline:2px solid #1E1B26;outline-offset:2px}.ds-primary:active{transform:scale(.98)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A frosted glass-chip pill with ink words: every action that is not the screen's one coral.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Reply in my voice</button>",
      "css": ".ds-secondary{height:48px;padding:0 20px;border:1px solid rgba(255,255,255,.6);border-radius:999px;background:rgba(255,255,255,.62);color:#1E1B26;font:500 15px/1 Inter,system-ui,sans-serif;-webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);box-shadow:inset 1px 1px 0 rgba(255,255,255,.7),0 6px 18px -10px rgba(40,30,60,.22)}.ds-secondary:hover{background:rgba(255,255,255,.9)}"
    },
    {
      "name": "Glass Panel",
      "kind": "container",
      "refersTo": "glass-panel",
      "description": "Frosted white over the aurora (55% soft, 72% strong), 28px radius, inset highlight, glass shadow; 92% white without backdrop-filter.",
      "html": "<section class=\"ds-glass\"><h3>Lisbon on $60 a day</h3><p>A fan-made guide by a crew of four.</p></section>",
      "css": ".ds-glass{padding:24px;border-radius:28px;border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);box-shadow:inset 1px 1px 0 rgba(255,255,255,.7),0 20px 60px -20px rgba(40,30,60,.18);color:#1E1B26}@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.ds-glass{background:rgba(255,255,255,.92)}}"
    },
