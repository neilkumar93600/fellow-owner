      "html": "<span class=\"ds-match\"><i></i>Strong match</span>",
      "css": ".ds-match{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.62);color:#1E1B26;font:500 12px/16px Inter,system-ui,sans-serif}.ds-match i{width:6px;height:6px;border-radius:50%;background:#15803D}"
    },
