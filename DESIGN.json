      "html": "<section class=\"ds-glass\"><h3>Lisbon on $60 a day</h3><p>A fan-made guide by a crew of four.</p></section>",
      "css": ".ds-glass{padding:24px;border-radius:40px;border:1px solid rgb(206 202 200/.75);background:rgb(255 255 255/.55);-webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);box-shadow:inset 1px 1px 0 rgb(255 255 255/.7),0 0 10px 0 rgb(0 0 0/.06);color:#242424}.ds-glass h3{font:400 24px/1.2 Newsreader,Georgia,serif;letter-spacing:-.02em;margin:0 0 8px}@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.ds-glass{background:rgb(255 255 255/.92)}}"
