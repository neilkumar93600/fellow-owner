  "narrative": {
    "northStar": "Parchment Frost: an editorial journal on warm parchment, lit by frosted glass.",
    "overview": "Frosted glass panels float on parchment with soft coral, sky-wash, gold and mint washes. Serif headings at weight 400, Geist Mono for the UI, Inter for long reads, hairline Ash borders and one Lake Blue action per screen. Imagery is realistic golden-hour photography of the fictional creator, Mira Lane.",
    "keyCharacteristics": [
      "No shell or frame: content floats on the washes.",
      "Three glass strengths: soft 55%, strong 72%, chip 62%; 92% white fallback without backdrop-filter.",
      "One Lake Blue (#2B59D1) action per screen; the rainbow button is retired.",
      "Active nav is a periwinkle chip with a lake icon.",
      "Headings are Newsreader at 400, never bold; the page default is Geist Mono; long reads are Inter.",
      "Pastels are decoration only."
    ],
    "rules": [
      "One Lake Blue primary per screen.",
      "Text on glass reaches WCAG AA; check with web/scripts/contrast-check.mjs.",
      "Headings are serif at weight 400, never bold.",
      "Nav, buttons, tags and 12px meta are uppercase mono; never uppercase sentences, names or user content.",
      "Long reads use font-sans (Inter) (owner decision).",
      "Panels 40px, pills full; no drop shadows on cards.",
      "Nothing loops forever in view; reduced motion makes the washes static.",
      "Platforms are added one link at a time and fetched in order; a failed card offers Retry and a manual count.",
      "The AI never sends anything to fans without a creator click."
    ],
    "dos": [
      "Put body text on glass, not on a bright wash.",
      "Use font-sans for post bodies, comments, legal text and newsletters.",
      "Keep Ash hairlines on every card and glass edge.",
      "Use 44px touch targets on fan pages."
    ],
    "donts": [
      "No rainbow CTA or gradient text.",
      "No saturated fill for any action other than the one Lake Blue primary.",
      "No pastel (coral, sky-wash, mint, gold, crimson) as text or under text.",
      "No bold headings.",
      "No drop shadows on cards; no opaque panels.",
      "No pewter shell, lime pill or purple primary (the old Clubhouse look).",
      "No raw fit numbers or score bars outside a side panel."
    ]
  }
}
