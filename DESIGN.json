  "narrative": {
    "northStar": "Golden Hour Frost: the last hour of light on a trip.",
    "overview": "Frosted glass panels float directly on a slow peach, sky, lilac and mint aurora over cream. Words are ink; one coral button per screen marks the thing to do. Instrument Serif sets display headlines (28px and up), Inter everything else. Imagery is realistic golden-hour photography of the fictional creator, Mira Lane.",
    "keyCharacteristics": [
      "No shell or frame: content floats on the aurora.",
      "Three glass strengths: soft 55%, strong 72%, chip 62%; 92% white fallback without backdrop-filter.",
      "One coral (#C8432A) action per screen; sunset (#F0603A) is decoration only.",
      "Active nav is a glass chip with an ink icon and a 3px sunset dot.",
      "Matches are words, never numbers, outside side panels."
    ],
    "rules": [
      "One coral per screen.",
      "Text on glass reaches WCAG AA; check with web/scripts/contrast-check.mjs.",
      "Serif only at 28px and up.",
      "Nothing loops forever in view; reduced motion makes the aurora static.",
      "Every image slot renders a same-ratio gradient until its file exists.",
      "The AI never sends anything to fans without a creator click."
    ],
    "dos": [
      "Put body text on glass, not on a bright aurora pool.",
      "Use the GlassPanel, MatchLabel and CreatorImage primitives.",
      "Use 44px touch targets on fan pages."
    ],
    "donts": [
      "No pewter shell, 40px app frame or header tray (the old Clubhouse look).",
      "No lime active pill, no purple primary button or focus ring.",
      "No flat 45% white glass without blur.",
      "No clay sphere canvas, clay loop video or clay art.",
      "No raw fit numbers or score bars outside a side panel."
    ]
  }
}
