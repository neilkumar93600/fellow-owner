# @fellow-owners/api environment. Copy to api/.env for local development.
# Names only for secrets: never commit values. In development most values have defaults
# (see src/config/env.ts); production requires every secret marked "required".

# --- runtime
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# --- database (Supabase transaction pooler in production, port 6543; prepare is disabled)
DATABASE_URL=postgres://fellow:fellow@localhost:5432/fellow_owners
# Integration tests (pnpm test:integration)
TEST_DATABASE_URL=postgres://fellow:fellow@localhost:5432/fellow_owners_test
# Pool size per process (default 5 in production, 10 locally)
DATABASE_POOL_MAX=

# --- web origin and auth (auth runs behind the web rewrite: BETTER_AUTH_URL is the WEB origin)
WEB_ORIGIN=http://localhost:3000
# Extra trusted origins, comma separated (preview deployments, other localhost ports)
TRUSTED_ORIGINS=
# required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- email (sign-in codes). Without RESEND_API_KEY in development the code is logged instead.
RESEND_API_KEY=
EMAIL_FROM=

# --- Google sign-in (optional; both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI through OpenRouter (Vercel AI SDK). Without a key the deterministic fake AI is used.
OPENROUTER_API_KEY=
AI_MODEL_FAST=openai/gpt-5.6-luna
AI_MODEL_SMART=anthropic/claude-sonnet-5.5
# 1536 dimensions, fixed by the schema
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Defaults to true when OPENROUTER_API_KEY is set
AI_ENABLED=

# --- media generation (seed assets only, fal.ai)
FAL_KEY=

# --- demo mode (POST /api/demo/session). Required when DEMO_ENABLED is true.
DEMO_ENABLED=true
DEMO_CREATOR_EMAIL=
DEMO_FAN_EMAIL=
DEMO_PASSWORD=

# --- platform
# Admin allowlist, comma separated emails
ADMIN_EMAILS=
# required in production: Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# required in production: salt for click visitor hashes
CLICK_SALT=
