# @fellow-owners/api environment. Copy to api/.env for local development.
# Names only for secrets: never commit values. In development most values have defaults
# (see src/config/env.ts); production requires every secret marked "required".

# --- runtime
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# --- database (Supabase transaction pooler in production, port 6543; prepare is disabled)
DATABASE_URL=postgres://fellow:fellow@localhost:5432/fellow_owners
# Integration tests (pnpm test:integration)
TEST_DATABASE_URL=postgres://fellow:fellow@localhost:5432/fellow_owners_test
# Pool size per process (default 5 in production, 10 locally)
DATABASE_POOL_MAX=

# --- redis (optional): auth rate-limit counters + live notification pub/sub; in process when empty
REDIS_URL=

# --- web origin and auth (auth runs behind the web rewrite: BETTER_AUTH_URL is the WEB origin)
WEB_ORIGIN=http://localhost:3000
# Extra trusted origins, comma separated (preview deployments, other localhost ports).
# https://appleid.apple.com is added on its own when Apple sign-in is on.
TRUSTED_ORIGINS=
# required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- email (email confirmation and password reset codes). Without RESEND_API_KEY in development
# the code is logged instead.
RESEND_API_KEY=
EMAIL_FROM=

# --- Social sign-in (optional; each provider needs both of its values, or neither).
# Redirect URI to register with each provider: {BETTER_AUTH_URL}/api/auth/callback/{google|apple|facebook}

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer > Certificates, Identifiers & Profiles. Client id: a Services ID with Sign in with
# Apple on (Apple wants an https domain, not localhost). Client secret: a JWT you sign with your
# Sign in with Apple key (.p8). It expires within 6 months: generate a new one before then.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Only for ID-token sign-in from a native iOS app
APPLE_APP_BUNDLE_IDENTIFIER=

# Meta for Developers > your app > Facebook Login: App ID and App Secret. This is Meta's login, so
# it also covers people who come from Instagram (Instagram has no login for personal accounts).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- AI through OpenRouter (Vercel AI SDK). Without a key the deterministic fake AI is used.
OPENROUTER_API_KEY=
AI_MODEL_FAST=openai/gpt-5.6-luna
AI_MODEL_SMART=anthropic/claude-sonnet-5.5
# 1536 dimensions, fixed by the schema
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Defaults to true when OPENROUTER_API_KEY is set
AI_ENABLED=

# --- media generation (seed assets only, fal.ai)
FAL_KEY=

# --- platform lookups in onboarding (Apify). Server-only: never NEXT_PUBLIC_*.
# Use a scoped token with a monthly spend limit set in the Apify console. Without a token,
# lookups return labelled sample data ("Sample data" chip); demo handles always use fixtures.
APIFY_TOKEN=
# Defaults to true when APIFY_TOKEN is set; set false to force sample data
APIFY_ENABLED=

# --- YouTube comment import (optional). YouTube Data API v3 key; without it the import returns
# labelled sample data.
YOUTUBE_API_KEY=

# --- image uploads (optional): an S3-compatible bucket (Railway bucket). Set all four values, or
# none (uploads are off and /api/media answers 503).
BUCKET_ENDPOINT=
# Default: auto
BUCKET_REGION=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# --- demo mode (POST /api/demo/session). Required when DEMO_ENABLED is true.
DEMO_ENABLED=true
DEMO_CREATOR_EMAIL=
DEMO_FAN_EMAIL=
DEMO_PASSWORD=

# --- platform
# Admin allowlist, comma separated emails
ADMIN_EMAILS=
# required in production: the cron service calls /api/cron/tick with Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# required in production: salt for click visitor hashes
CLICK_SALT=
