{
  "name": "@fellow-owners/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express 5 API: business logic, auth, AI, database",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "start": "node --env-file-if-exists=.env dist/local.js",
    "build": "pnpm --filter @fellow-owners/shared build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/seed.ts",
    "db:embed": "tsx --env-file-if-exists=.env src/db/seed/embed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fellow-owners/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@vercel/functions": "^3.9.9",
    "ai": "^7.0.126",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "resend": "^6.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
